{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "server.js": {
      "runtime": "vercel-nodejs@18.x"
    }
  },
  "crons": [
    {
      "path": "/api/cron/deadline-check",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/cron/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    }
  ]
}
